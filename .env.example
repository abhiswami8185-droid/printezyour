# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# PRINTEZYOUR PRODUCTION DEPLOYMENT CONFIGURATION
# ==============================================================================

# --- Scenario 1: Full-Stack Node.js Deployment (Hostinger / VPS / Cloud Run) ---
# When hosting frontend and backend together on the same Node.js server:
PORT=3000
NODE_ENV=production
# In full-stack deployment, frontend uses same-origin /api calls (leave VITE_API_URL empty)
VITE_API_URL=
# Base path for root domain deployment
VITE_BASE_PATH=/
# Allowed CORS origins (can be '*' or your domain)
ALLOWED_ORIGINS=https://printezyour.com,https://admin.printezyour.com

# --- Scenario 2: Decoupled GitHub Pages Frontend + External Node.js Backend ---
# When deploying the static frontend to GitHub Pages:
# GitHub Pages URL: https://abhiswami8185-droid.github.io/printezyour/
# 1. Frontend Build variables (passed during build/GitHub Actions):
# VITE_BASE_PATH=/printezyour/
# VITE_API_URL=https://api.yourdomain.com (point to your live Node.js server)
#
# 2. Backend Server variables (on Hostinger / VPS):
# PORT=3000
# NODE_ENV=production
# ALLOWED_ORIGINS=https://abhiswami8185-droid.github.io,https://abhiswami8185-droid.github.io/printezyour

# --- Optional Domain Separation / Subdomain Configuration ---
# Configure these if using separate storefront and back-office subdomains:
# PUBLIC_SITE_URL=https://printezyour.com
# ADMIN_SITE_URL=https://admin.printezyour.com
# VITE_PUBLIC_SITE_URL=https://printezyour.com
# VITE_ADMIN_SITE_URL=https://admin.printezyour.com


